<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>EdoardoTona.Rustino</PackageId>
    <Description>Cross-platform native webview windows powered by Rust (wry/tao). Drop-in replacement for Photino.NET.</Description>
    <Authors>Edoardo Tona</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EdoardoTona/Rustino</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EdoardoTona/Rustino</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Host (build machine) native library information. `NETCoreSdkRuntimeIdentifier` is the RID of
    the machine running the build, matching the default cargo target (e.g. osx-arm64, win-x64).
  -->
  <PropertyGroup>
    <_RustinoHostRuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</_RustinoHostRuntimeIdentifier>
    <_RustinoHostNativeFileName Condition="$([MSBuild]::IsOSPlatform('Windows'))">rustino_native.dll</_RustinoHostNativeFileName>
    <_RustinoHostNativeFileName Condition="$([MSBuild]::IsOSPlatform('OSX'))">librustino_native.dylib</_RustinoHostNativeFileName>
    <_RustinoHostNativeFileName Condition="$([MSBuild]::IsOSPlatform('Linux'))">librustino_native.so</_RustinoHostNativeFileName>
    <_RustinoHostNativeSource>../Rustino.Native/target/release/$(_RustinoHostNativeFileName)</_RustinoHostNativeSource>
    <_RustinoHostNativeStaged>runtimes/$(_RustinoHostRuntimeIdentifier)/native/$(_RustinoHostNativeFileName)</_RustinoHostNativeStaged>
  </PropertyGroup>

  <!--
    Native library layout.

    Binaries are always emitted under `runtimes/<rid>/native/`, never at the output root.
    `NativeLibraryResolver` probes `runtimes/<process-rid>/native/` at runtime and loads the
    matching binary, so the build host's library (e.g. a .dylib while cross-publishing for
    Windows or Linux) can never shadow the target platform's binary.

    Local dev: the cargo build of the current platform is copied into the layout.
    CI / cross-platform: `cargo build release for a target triple` and stage the results into
    runtimes/<rid>/native/ (see .github/workflows/release.yml); those are copied to the output
    of consuming apps and packed into the NuGet package.
  -->
  <ItemGroup Condition="Exists('$(_RustinoHostNativeSource)') And '$(_RustinoHostNativeFileName)' != '' And !Exists('$(_RustinoHostNativeStaged)')">
    <Content Include="$(_RustinoHostNativeSource)"
             Pack="false"
             CopyToOutputDirectory="PreserveNewest"
             Link="$(_RustinoHostNativeStaged)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Staged cross-platform binaries follow the app to its output/publish directory and ship inside
      the NuGet package for RID-aware consumers. They must not also be Content with Pack="false":
      NuGet pack excludes those files by path, which would drop them from the package as well.
      PackagePath="/" because NuGet appends the relative path (runtimes/<rid>/native/...).
    -->
    <None Update="runtimes/**/*" Pack="true" PackagePath="/" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- NuGet packaging -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
