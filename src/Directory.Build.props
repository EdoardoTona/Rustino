<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    The NuGet packages: the same metadata for all. The release workflow sets their version
    (/p:Version, from the tag of the GitHub release); local builds are 0.0.0.
  -->
  <PropertyGroup>
    <Version>0.0.0</Version>
    <Authors>Edoardo Tona</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EdoardoTona/Rustino</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EdoardoTona/Rustino</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
