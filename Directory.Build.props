<Project>

  <!--
    Shared by every project of the repository. Packages add their metadata in src/Directory.Build.props;
    packages and tests also target .NET 11, the samples only .NET 11.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
